# Written by `npx convex dev`. Shown here so you know what to expect.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Cloudflare Turnstile site key (public). This test key always passes.
# Use a real key from the Cloudflare dashboard in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# These go on the Convex deployment with `npx convex env set`, not in this file:
#   SUPERMEMORY_API_KEY           your Supermemory key
#   TURNSTILE_SECRET_KEY          1x0000000000000000000000000000000AA for local testing
#   TURNSTILE_EXPECTED_HOSTNAME   optional, e.g. your production hostname
#   SITE_URL                      where the frontend runs
#   JWT_PRIVATE_KEY, JWKS         from `node scripts/generate-auth-keys.mjs`
#   DEMO_DAILY_PROVIDER_CALLS     optional, default 500
#   DEMO_PAUSED                   set to "true" to stop paid calls
#   DEMO_NAMESPACE_PREFIX         optional, default "smdemo"
